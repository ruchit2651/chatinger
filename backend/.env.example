PORT=5000
CLIENT_URL=http://localhost:5173
APP_NAME=Chatinger
JWT_SECRET=change-me-to-a-long-random-secret

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ---------------------------------------------------------------------
# Email (Brevo HTTPS API for OTP + welcome messages)
#
# Render blocks outbound SMTP, so we send through Brevo's HTTPS API.
#
# 1. Sign up at https://www.brevo.com (free 300 emails/day, no card).
# 2. Verify your sender email:
#      Senders, Domains & Dedicated IPs -> Senders -> Add a sender
#      Use the same address you put in EMAIL_SENDER_EMAIL below and
#      click the confirmation link Brevo emails you.
# 3. Generate an API key:
#      SMTP & API -> API Keys -> Generate a new API key
#    Paste the key (starts with "xkeysib-") into BREVO_API_KEY.
#
# If you leave BREVO_API_KEY empty, the backend prints OTP codes to the
# server console instead of emailing — useful for local dev.
# ---------------------------------------------------------------------
BREVO_API_KEY=
EMAIL_SENDER_EMAIL=your-verified-sender@example.com
EMAIL_SENDER_NAME=Chatinger

# ---------------------------------------------------------------------
# Web Push (VAPID keys for browser push notifications)
#
# Generate a keypair once:
#   node -e "const k = require('web-push').generateVAPIDKeys(); \
#            console.log('VAPID_PUBLIC_KEY=' + k.publicKey); \
#            console.log('VAPID_PRIVATE_KEY=' + k.privateKey);"
#
# Paste the two halves below. VAPID_SUBJECT can be any mailto: address
# you control — it identifies your service to the push provider.
# Leave VAPID_PUBLIC_KEY empty to disable push notifications.
# ---------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
